BA_ "BusType" "CAN";
BA_ "GenMsgCycleTime" BO_ 1025 100;
BA_ "GenMsgCycleTime" BO_ 1281 100;
VAL_ 1025 BCM_IgnitionSts 3 "Start" 2 "On" 1 "Acc" 0 "Off" ;
VAL_ 1025 BCM_BrakePedal 1 "Pressed" 0 "Released" ;
VAL_ 1025 BCM_DriverDoor 1 "Open" 0 "Closed" ;
VAL_ 1025 BCM_CrashSts 1 "Crash" 0 "NoCrash" ;
VAL_ 1281 CVC_ReadyLamp 1 "On" 0 "Off" ;
VAL_ 1281 CVC_HVWarnLamp 1 "On" 0 "Off" ;
VAL_ 1281 CVC_VehicleSts 5 "HV_Off" 4 "Fault" 3 "Ready" 2 "HV_Precharge" 1 "Standby" 0 "Off" ;
